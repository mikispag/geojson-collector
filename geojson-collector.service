[Unit]
Description=GeoJSON Collector Daemon for iOS Overland
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=geojson-collector
Group=geojson-collector
ExecStart=/usr/local/bin/geojson-collector serve --config /etc/geojson-collector/config.json
Restart=always
RestartSec=5s

# Directory Management
StateDirectory=geojson-collector
ConfigurationDirectory=geojson-collector

# Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
